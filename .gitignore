/target
**/*.rs.bk
*.pdb

# npm dev dependencies for the wasm package's dev harness (biome lint only);
# installed locally and in CI via `npm install`, never committed.
node_modules/
crates/elenchus-wasm/package-lock.json

# proptest failure-seed files (regenerated locally on a failing case; we don't
