**/*.proptest-regressions

# cargo-tarpaulin coverage output (see tarpaulin.toml: output-dir = "coverage")
/coverage
*.profraw
cobertura.xml
tarpaulin-report.html
lcov.info
.pi/pi-code-planner/worktrees/
